// "Computer Programs" Patchouli guide (patchouli_books/computer_programs): book + a CC floppy or an OC keyboard
recipes.addShapeless("computer_programs_book_cc", <patchouli:guide_book>.withTag({"patchouli:book": "patchouli:computer_programs"}),
[<minecraft:book>, <computercraft:disk_expanded> | <computercraft:disk>]);
recipes.addShapeless("computer_programs_book_oc", <patchouli:guide_book>.withTag({"patchouli:book": "patchouli:computer_programs"}),
[<minecraft:book>, <opencomputers:keyboard>]);
