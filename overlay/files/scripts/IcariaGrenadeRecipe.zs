// The Greek Fire Grenade opens the Lands of Icaria portal, but its own recipe needs materials from
// inside Icaria. This one lets a player make the first grenade in the Overworld.
recipes.addShaped("icaria_greek_fire_grenade_overworld", <landsoficaria:greek_fire_grenade>, [
    [null, <minecraft:string>, null],
    [<ore:nuggetIron>, <minecraft:blaze_powder>, <ore:nuggetIron>],
    [null, <ore:nuggetIron>, null]
]);
